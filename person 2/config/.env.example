# CrowdGPU Worker — Environment Configuration
# Copy to .env and adjust values.  Load with: export $(cat .env | xargs)
# Or set in your shell / Docker Compose / Kubernetes Secret.

# ─── Required ─────────────────────────────────────────────────────────────────
COORDINATOR_URL=http://localhost:8000

# ─── Optional (have sensible defaults) ────────────────────────────────────────
WORKER_ID=worker-gpu-01
GPU_ID=0
HEARTBEAT_INTERVAL=30
