# CrowdGPU Web Portal — Environment Variables Reference
#
# Copy this file to .env.local to customise for your local setup.
# .env.local is excluded from Git via .gitignore and must never be committed.
#
# ── VITE_USE_MOCK ─────────────────────────────────────────────────────────────
# Controls whether mock / demo data is used:
#
# false → (Default) Use real Coordinator backend endpoints:
#         /health, /api/v1/peers, /api/v1/jobs, and /ws/signaling.
#         Accurate errors and live worker states are displayed.
#
# true  → Offline UI preview mode with fixture data (for design testing only).
#
VITE_USE_MOCK=false

# ── VITE_API_BASE_URL ─────────────────────────────────────────────────────────
# Base URL of the CrowdGPU Coordinator API.
#
# Leave empty (default) in development to use the Vite dev proxy configured in vite.config.js:
#   /health     → http://localhost:8000/health
#   /api/v1/*   → http://localhost:8000/api/v1/*
#
# In production, set to your coordinator origin:
#   VITE_API_BASE_URL=https://coordinator.example.com
#
# CRITICAL SECURITY NOTE:
# All VITE_* environment variables are embedded into client-side browser JavaScript.
# NEVER place private tokens, database credentials, or secret keys in this file.
#
VITE_API_BASE_URL=

# ── VITE_DEMO_USER_ID ─────────────────────────────────────────────────────────
# Development demo user UUID (matches coordinator demo identity when DEMO_AUTH_ENABLED=true).
VITE_DEMO_USER_ID=00000000-0000-0000-0000-000000000001
