# =============================================================================
# CrowdGPU — Unified Environment Configuration Reference (.env.example)
#
# INSTRUCTIONS:
# Copy this file to '.env' (or set corresponding environment variables in your
# system / deployment platform). DO NOT commit your live '.env' or '.env.local'
# files containing real credentials to version control.
# =============================================================================

# =============================================================================
# 1. COORDINATOR SERVICE (FastAPI)
# =============================================================================
# Environment mode: 'development', 'staging', or 'production'
# In 'production' mode, CrowdGPU enforces strict security checks:
#   - DEMO_AUTH_ENABLED must be false
#   - Insecure default passwords ('changeme') are rejected on startup
#   - WebRTC signaling HMAC tokens are strictly required
#   - CORS is restricted to explicit origins in CORS_ALLOWED_ORIGINS
ENVIRONMENT=development

# Secret key used for cryptographic HMAC token signing and JWT validation.
# MUST be changed to a high-entropy string (e.g. openssl rand -hex 32) in production.
SECRET_KEY=changeme-development-only-secret-key-min-32-chars

# PostgreSQL Database Connection URL.
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
# In production, default passwords like 'changeme' will cause startup failure.
DATABASE_URL=postgresql+asyncpg://crowdgpu:changeme@127.0.0.1:5432/crowdgpu

# Allow development demo user identity fallback (UUID: 00000000-0000-0000-0000-000000000001).
# MUST BE FALSE in staging/production.
DEMO_AUTH_ENABLED=true

# Comma-separated or JSON list of allowed HTTP origins for CORS.
# Wildcard '*' is disallowed when credentials are supported.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# WebRTC Signaling Security:
# Require cryptographic HMAC proof of peer identity on WebSocket handshake.
SIGNALING_REQUIRE_TOKEN=false
# Maximum allowed signaling messages per minute per connected peer before 4029 rate-limiting.
SIGNALING_RATE_LIMIT_PER_MINUTE=180

# WebRTC NAT Traversal (STUN / TURN):
# STUN is sufficient for local development and non-symmetric NATs.
# TURN (coturn) relay server is REQUIRED for production symmetric NAT traversal.
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Job Execution Timeouts (seconds):
JOB_TIMEOUT_DEFAULT=600
JOB_TIMEOUT_MAX=3600

# =============================================================================
# 2. GPU WORKER SERVICE (Python / PyTorch CUDA)
# =============================================================================
# Target coordinator base HTTP URL
COORDINATOR_URL=http://127.0.0.1:8000

# Unique persistent worker identifier
WORKER_ID=demo-rtx3050-worker

# CUDA GPU physical device index (usually 0)
GPU_ID=0

# Interval in seconds between periodic heartbeats to coordinator
HEARTBEAT_INTERVAL=5

# Polling frequency in seconds when idle and querying /jobs/next
POLL_INTERVAL=1.0

# Execution backend: 'native' (in-process torch/cuda executor) or 'docker' (isolated container)
EXECUTION_BACKEND=native

# Docker Execution Security Constraints (when EXECUTION_BACKEND=docker):
# Containers run with read-only rootfs, network disabled, capped RAM & execution timeout.
DOCKER_MAX_CONTAINER_MEMORY=4g
DOCKER_READ_ONLY_ROOTFS=true
DOCKER_NETWORK_DISABLED=true

# =============================================================================
# 3. CLI CLIENT
# =============================================================================
CROWDGPU_COORDINATOR_URL=http://127.0.0.1:8000
CROWDGPU_API_KEY=
CROWDGPU_OUTPUT_FORMAT=table

# =============================================================================
# 4. WEB FRONTEND (apps/web)
# =============================================================================
# Note: Variables prefixed with VITE_ are baked into frontend JavaScript bundles.
# NEVER put private API secrets, database passwords, or signing keys in VITE_ variables!
VITE_USE_MOCK=false
VITE_API_BASE_URL=
VITE_DEMO_USER_ID=00000000-0000-0000-0000-000000000001
